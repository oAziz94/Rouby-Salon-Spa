# Usually inherited from repo root `.env`. Duplicate only variables the API reads.

PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://rouby:rouby@localhost:5432/rouby_salon?schema=public

API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

OTP_PROVIDER=dummy
OTP_ENABLED=true
