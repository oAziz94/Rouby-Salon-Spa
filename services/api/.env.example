# BOOKING_REMINDER_HOURS_BEFORE=24
# BOOKING_REMINDER_MINUTES_BEFORE_FINAL=90

MEDIA_STORAGE=local
MEDIA_STORAGE_ROOT=uploads
PUBLIC_MEDIA_BASE_URL=http://localhost:4000

