# Copy to .env at repo root for local development.

# PostgreSQL (see docker-compose.yml for defaults)
DATABASE_URL="postgresql://rouby:rouby@localhost:5432/rouby_salon?schema=public"

# API (NestJS — services/api)
PORT=4000
NODE_ENV=development
API_URL=http://localhost:4000
# Comma-separated browser origins for CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Defaults (Africa/Cairo, EGP per docs/ARCHITECTURE.md)
DEFAULT_TIMEZONE=Africa/Cairo
DEFAULT_CURRENCY=EGP

# JWT (dashboard access tokens; aud=dashboard). Required for API boot.
JWT_SECRET=change-me-to-a-long-random-string
# Access token TTL (e.g. 1h, 3600, 15m). No refresh tokens in Sprint 1.
JWT_EXPIRES_IN=1h

# Client JWT (aud=client). Minted by phone OTP verify endpoint.
CLIENT_JWT_EXPIRES_IN=8h
# OTP settings (Sprint 11.4)
CLIENT_OTP_TTL_SECONDS=300
CLIENT_OTP_MAX_ATTEMPTS=5
CLIENT_OTP_REQUEST_COOLDOWN_SECONDS=60
# Optional secret for OTP hashing salt (falls back to empty if omitted)
# OTP_CODE_SECRET=change-me-otp-secret

# Seed (prisma db seed). Owner user: owner@alrouby.local
SEED_OWNER_PASSWORD=change-me-min-8-chars
# Optional: reception@alrouby.local (Receptionist, default branch) for RBAC checks
# SEED_RECEPTIONIST_PASSWORD=
# Optional: mona.staff@alrouby.local / nour.staff@alrouby.local (Staff role + profiles/schedules)
# SEED_STAFF_PASSWORD=

# Swagger: in production set to false unless you intentionally expose docs
SWAGGER_ENABLED=false

# Next.js apps — base URL for browser calls to the API (include /api/v1 if you use apiUrl() helpers)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Public base URL for uploaded media (same host as API by default). Used in stored imageUrl values.
PUBLIC_MEDIA_BASE_URL=http://localhost:4000
# Optional: relative folder under process.cwd() for disk uploads (default: uploads)
# MEDIA_STORAGE_ROOT=uploads

# Future sprints (do not set until implemented)
# REDIS_URL=
# GOOGLE_CLIENT_ID=
# FACEBOOK_APP_ID=
# Sprint 6: digits only (no +), used when branch.whatsapp is empty for wa.me deep links
# WHATSAPP_DEFAULT_NUMBER=201234567890
