# Copy to `.env` at the repo root for local development.
# See docs/DEPLOYMENT.md for production (Render, Cloudflare, Cloudinary).

# --- PostgreSQL (existing database; do not create a new production DB for this rollout) ---
DATABASE_URL="postgresql://rouby:rouby@localhost:5432/rouby_salon?schema=public"
# Optional: direct connection for Prisma Migrate (same as DATABASE_URL if not using PgBouncer)
# DIRECT_URL="postgresql://rouby:rouby@localhost:5432/rouby_salon?schema=public"

# --- API (NestJS — services/api) ---
PORT=4000
NODE_ENV=development
# Public API origin (no trailing path); used if PUBLIC_MEDIA_BASE_URL is unset
API_URL=http://localhost:4000
# Comma-separated browser origins, no trailing slashes (production on Render: list every
# frontend origin, e.g. https://your-web.onrender.com,https://your-dashboard.onrender.com).
# CORS_ORIGINS is still supported.
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001

DEFAULT_TIMEZONE=Africa/Cairo
DEFAULT_CURRENCY=EGP
# Optional default VAT % for new environments (business settings may override in DB)
# DEFAULT_VAT_RATE=14

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

CLIENT_JWT_EXPIRES_IN=8h
CLIENT_OTP_TTL_SECONDS=300
CLIENT_OTP_MAX_ATTEMPTS=5
CLIENT_OTP_REQUEST_COOLDOWN_SECONDS=60
# OTP_CODE_SECRET=change-me-otp-secret

# Dummy OTP (returns devCode in API response; temporary — replace before public launch)
OTP_PROVIDER=dummy
OTP_ENABLED=true
# Set to false to stop returning devCode even for dummy provider (e.g. staged demos)
# OTP_DUMMY_EXPOSE_CODE=true

SWAGGER_ENABLED=false

# --- Media ---
# local = disk under services/api/uploads; cloudinary = new uploads go to Cloudinary
MEDIA_STORAGE=local
MEDIA_STORAGE_ROOT=uploads
PUBLIC_MEDIA_BASE_URL=http://localhost:4000

# Cloudinary (required when MEDIA_STORAGE=cloudinary)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=alrouby

# --- Next.js apps ---
# May be scheme+host only (e.g. https://api.onrender.com); clients append /api/v1 when path is empty.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3001
# Legacy alias used by dashboard “Preview website” until everything uses NEXT_PUBLIC_WEB_URL
# NEXT_PUBLIC_PUBLIC_WEBSITE_URL=http://localhost:3000

# --- Seed (local only; no production seed system in this rollout) ---
SEED_OWNER_PASSWORD=change-me-min-8-chars
