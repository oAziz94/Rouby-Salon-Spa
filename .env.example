# Copy to `.env` at the repo root for local development.
# See docs/DEPLOYMENT.md for production (Render, Cloudflare, Cloudinary).

# --- PostgreSQL ---
DATABASE_URL="postgresql://rouby:rouby@localhost:5432/rouby_salon?schema=public"
# DIRECT_URL="postgresql://rouby:rouby@localhost:5432/rouby_salon?schema=public"

# --- API (NestJS — services/api) ---
PORT=4000
NODE_ENV=development
API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

DEFAULT_TIMEZONE=Africa/Cairo
DEFAULT_CURRENCY=EGP

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

CLIENT_JWT_EXPIRES_IN=8h
CLIENT_OTP_TTL_SECONDS=300
CLIENT_OTP_MAX_ATTEMPTS=5
CLIENT_OTP_REQUEST_COOLDOWN_SECONDS=60
# OTP_CODE_SECRET=change-me-otp-secret

# OTP delivery: dummy (local/dev only) or whatsapp (production via WAPilot)
OTP_PROVIDER=dummy
OTP_ENABLED=true
# OTP_DUMMY_EXPOSE_CODE=true

# WhatsApp OTP (when OTP_PROVIDER=whatsapp)
# WHATSAPP_PROVIDER=wapilot
# WAPILOT_API_BASE_URL=https://api.wapilot.net/api/v2
# WAPILOT_API_TOKEN=
# WAPILOT_INSTANCE_ID=
# Egyptian mobiles: international digits without "+" (e.g. 201001234567) for WAPilot chat_id.

# Transactional WhatsApp booking notifications (off locally; uses same WAPilot credentials)
NOTIFICATIONS_ENABLED=false
BOOKING_REMINDER_HOURS_BEFORE=24
BOOKING_REMINDER_MINUTES_BEFORE_FINAL=90

SWAGGER_ENABLED=false

# --- Media ---
MEDIA_STORAGE=local
MEDIA_STORAGE_ROOT=uploads
PUBLIC_MEDIA_BASE_URL=http://localhost:4000

# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=alrouby

# --- Next.js apps ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3001

# --- Seed (local only) ---
SEED_OWNER_PASSWORD=change-me-min-8-chars
