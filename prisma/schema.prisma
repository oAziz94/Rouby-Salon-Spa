generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Minimal branch row for Sprint 1 (User.branchId FK). CRUD APIs in Sprint 2.
model Branch {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  address      String   @default("")
  phone        String   @default("")
  whatsapp     String   @default("")
  mapUrl       String   @default("") @map("map_url")
  workingHours Json?    @map("working_hours")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  users           User[]
  serviceBranches ServiceBranch[]
  packageBranches PackageBranch[]

  @@map("branches")
}

/// Singleton global VAT + payment/deposit policy (Sprint 2). One row; fixed id in seed.
model SystemSettings {
  id                    String               @id @db.Uuid
  vatEnabled            Boolean              @map("vat_enabled")
  defaultVatRate        Decimal              @map("default_vat_rate") @db.Decimal(6, 5)
  pricesIncludeVat      Boolean              @map("prices_include_vat")
  showVatOnInvoice      Boolean              @map("show_vat_on_invoice")
  taxRegistrationNumber String?            @map("tax_registration_number")
  paymentDepositPolicy  PaymentDepositPolicy @map("payment_deposit_policy")
  updatedByUserId       String?              @map("updated_by_user_id") @db.Uuid
  updatedAt             DateTime             @updatedAt @map("updated_at")

  updatedBy User? @relation("SystemSettingsUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@map("system_settings")
}

enum PaymentDepositPolicy {
  PAY_AT_SALON
  OPTIONAL_DEPOSIT
  REQUIRED_DEPOSIT
  FUTURE_ONLINE
  MANUAL_INSTAPAY
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  level       Int
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  module      String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  phone        String?
  passwordHash String   @map("password_hash")
  roleId       String   @map("role_id") @db.Uuid
  branchId     String?  @map("branch_id") @db.Uuid
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  role   Role    @relation(fields: [roleId], references: [id], onDelete: Restrict)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  systemSettingsUpdates SystemSettings[] @relation("SystemSettingsUpdatedBy")

  @@index([roleId])
  @@index([branchId])
  @@map("users")
}

// --- Sprint 3: Catalog ---

model ServiceCategory {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  imageUrl    String?  @map("image_url")
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  services Service[]

  @@map("service_categories")
}

model Service {
  id                  String            @id @default(uuid()) @db.Uuid
  categoryId          String            @map("category_id") @db.Uuid
  name                String
  description         String?
  imageUrl            String?           @map("image_url")
  priceDisplayType    PriceDisplayType  @map("price_display_type")
  basePrice           Decimal?          @map("base_price") @db.Decimal(12, 2)
  basePriceMax        Decimal?          @map("base_price_max") @db.Decimal(12, 2)
  durationMinutes     Int?              @map("duration_minutes")
  isTaxable           Boolean           @default(true) @map("is_taxable")
  bookingAvailability Boolean           @default(true) @map("booking_availability")
  preparationNotes    String?         @map("preparation_notes")
  aftercareNotes      String?           @map("aftercare_notes")
  isActive            Boolean           @default(true) @map("is_active")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  category        ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  branches        ServiceBranch[]
  variants        ServiceVariant[]
  packageServices PackageService[]
  bundleServices  BundleService[]

  @@index([categoryId, isActive])
  @@map("services")
}

model ServiceBranch {
  serviceId String @map("service_id") @db.Uuid
  branchId  String @map("branch_id") @db.Uuid

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([serviceId, branchId])
  @@index([branchId])
  @@map("service_branches")
}

model ServiceVariant {
  id              String   @id @default(uuid()) @db.Uuid
  serviceId       String   @map("service_id") @db.Uuid
  name            String
  description     String?
  price           Decimal  @db.Decimal(12, 2)
  durationMinutes Int      @map("duration_minutes")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, isActive])
  @@map("service_variants")
}

model Package {
  id             String    @id @default(uuid()) @db.Uuid
  name           String
  description    String?
  imageUrl       String?   @map("image_url")
  originalPrice  Decimal   @map("original_price") @db.Decimal(12, 2)
  packagePrice   Decimal   @map("package_price") @db.Decimal(12, 2)
  durationMinutes Int      @map("duration_minutes")
  startDate      DateTime? @map("start_date") @db.Date
  endDate        DateTime? @map("end_date") @db.Date
  isTaxable      Boolean   @default(true) @map("is_taxable")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  services PackageService[]
  branches PackageBranch[]

  @@index([isActive])
  @@map("packages")
}

model PackageService {
  packageId String @map("package_id") @db.Uuid
  serviceId String @map("service_id") @db.Uuid
  sortOrder Int    @default(0) @map("sort_order")

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@id([packageId, serviceId])
  @@index([serviceId])
  @@map("package_services")
}

model PackageBranch {
  packageId String @map("package_id") @db.Uuid
  branchId  String @map("branch_id") @db.Uuid

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([packageId, branchId])
  @@index([branchId])
  @@map("package_branches")
}

model Bundle {
  id               String     @id @default(uuid()) @db.Uuid
  name             String
  description      String?
  bundleType       BundleType @map("bundle_type")
  price            Decimal    @db.Decimal(12, 2)
  rules            Json?
  selectableCount  Int        @map("selectable_count")
  startDate        DateTime?  @map("start_date") @db.Date
  endDate          DateTime?  @map("end_date") @db.Date
  isActive         Boolean    @default(true) @map("is_active")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  services BundleService[]

  @@index([isActive])
  @@map("bundles")
}

model BundleService {
  bundleId  String @map("bundle_id") @db.Uuid
  serviceId String @map("service_id") @db.Uuid
  sortOrder Int    @default(0) @map("sort_order")

  bundle  Bundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@id([bundleId, serviceId])
  @@index([serviceId])
  @@map("bundle_services")
}

model Offer {
  id                    String           @id @default(uuid()) @db.Uuid
  name                  String
  offerCode             String?          @unique @map("offer_code")
  discountType          OfferDiscountType @map("discount_type")
  discountValue         Decimal          @map("discount_value") @db.Decimal(12, 4)
  startDate             DateTime         @map("start_date") @db.Date
  endDate               DateTime         @map("end_date") @db.Date
  usageLimit            Int?             @map("usage_limit")
  perClientUsageLimit   Int?             @map("per_client_usage_limit")
  isActive              Boolean          @default(true) @map("is_active")
  eligibilityRules      Json?            @map("eligibility_rules")
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("offers")
}

enum PriceDisplayType {
  FIXED
  STARTS_FROM
  RANGE
  CONTACT
  HIDDEN
}

enum BundleType {
  FIXED
  FLEXIBLE
  QUANTITY
  MEMBERSHIP_STYLE
}

enum OfferDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  SERVICE
  PACKAGE
  BUNDLE
  FIRST_BOOKING
  SEASONAL
  PROMO_CODE
}
