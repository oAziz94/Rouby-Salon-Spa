generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Minimal branch row for Sprint 1 (User.branchId FK). CRUD APIs in Sprint 2.
model Branch {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  address      String   @default("")
  phone        String   @default("")
  whatsapp     String   @default("")
  mapUrl       String   @default("") @map("map_url")
  workingHours Json?    @map("working_hours")
  /// Branch-level defaults for slot generation (same shape as system-level defaults).
  slotGenerationDefaults Json? @map("slot_generation_defaults")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  users            User[]
  userBranchAccesses UserBranchAccess[]
  serviceBranches  ServiceBranch[]
  packageBranches  PackageBranch[]
  bookingSlots     BookingSlot[]
  bookings         Booking[]
  clientsPreferred Client[]        @relation("ClientPreferredBranch")
  queueEntries          QueueEntry[]
  cashDrawerSessions    CashDrawerSession[]
  cashDrawerMovements   CashDrawerMovement[]
  dailyClosings         DailyClosing[]
  defaultForSystemSettings SystemSettings[] @relation("SystemSettingsDefaultBranch")
  reviews               Review[]
  staffProfiles         StaffProfile[]
  staffSchedules        StaffSchedule[]
  staffScheduleExceptions StaffScheduleException[]
  closures              BranchClosure[]

  @@map("branches")
}

/// Singleton global VAT + payment/deposit policy (Sprint 2). One row; fixed id in seed.
model SystemSettings {
  id                      String               @id @db.Uuid
  salonName               String               @default("Alrouby Salon & Spa") @map("salon_name")
  legalName               String?              @map("legal_name")
  phone                   String?              @map("phone")
  whatsappNumber          String?              @map("whatsapp_number")
  email                   String?              @map("email")
  address                 String?              @map("address")
  instagramHandle         String?              @map("instagram_handle")
  facebookPage            String?              @map("facebook_page")
  defaultBranchId         String?              @map("default_branch_id") @db.Uuid
  vatEnabled              Boolean              @map("vat_enabled")
  vatRatePercent          Decimal              @default(14) @map("vat_rate_percent") @db.Decimal(5, 2)
  taxLabel                String               @default("VAT") @map("tax_label")
  defaultVatRate          Decimal              @map("default_vat_rate") @db.Decimal(6, 5)
  pricesIncludeVat        Boolean              @map("prices_include_vat")
  showVatOnInvoice        Boolean              @map("show_vat_on_invoice")
  taxRegistrationNumber  String?              @map("tax_registration_number")
  receiptTitle            String               @default("Receipt") @map("receipt_title")
  receiptFooterMessage    String?              @map("receipt_footer_message")
  receiptWidth            String               @default("80mm") @map("receipt_width")
  showSalonPhoneOnReceipt Boolean              @default(true) @map("show_salon_phone_on_receipt")
  showBranchAddressOnReceipt Boolean           @default(true) @map("show_branch_address_on_receipt")
  showVatBreakdown        Boolean              @default(true) @map("show_vat_breakdown")
  showPaymentBreakdown    Boolean              @default(true) @map("show_payment_breakdown")
  showCashierName         Boolean              @default(true) @map("show_cashier_name")
  paymentDepositPolicy    PaymentDepositPolicy @map("payment_deposit_policy")
  /// Max discount (% of subtotal) a user without `bookings.discount.apply_unlimited` may apply.
  discountLimitPercentWithoutApproval Decimal @default(15) @map("discount_limit_percent_without_approval") @db.Decimal(5, 2)
  /// Day close with open visits / unpaid invoices: ALERT = allowed with a carry-over reason, BLOCK = refused.
  dayCloseOpenItemsPolicy DayCloseOpenItemsPolicy @default(ALERT) @map("day_close_open_items_policy")
  /// Loyalty program (price-list card): points per EGP paid, redemption block, visit reward.
  loyaltyEnabled          Boolean   @default(false) @map("loyalty_enabled")
  loyaltyPointsPerEgp     Decimal   @default(1) @map("loyalty_points_per_egp") @db.Decimal(8, 4)
  loyaltyRedeemPoints     Int       @default(1000) @map("loyalty_redeem_points")
  loyaltyRedeemValue      Decimal   @default(50) @map("loyalty_redeem_value") @db.Decimal(12, 2)
  loyaltyVisitsForReward  Int       @default(5) @map("loyalty_visits_for_reward")
  loyaltyRewardServiceId  String?   @map("loyalty_reward_service_id") @db.Uuid
  /// Payments and visits count from this moment (set when the program is first enabled).
  loyaltyStartedAt        DateTime? @map("loyalty_started_at")
  /// Global defaults for dashboard "generate week slots" (JSON: schemaVersion, workingDays, times, etc.).
  slotGenerationDefaults  Json?                @map("slot_generation_defaults")
  updatedByUserId         String?              @map("updated_by_user_id") @db.Uuid
  updatedAt               DateTime             @updatedAt @map("updated_at")

  defaultBranch Branch? @relation("SystemSettingsDefaultBranch", fields: [defaultBranchId], references: [id], onDelete: SetNull)
  updatedBy User? @relation("SystemSettingsUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([defaultBranchId])
  @@map("system_settings")
}

enum DayCloseOpenItemsPolicy {
  ALERT
  BLOCK
}

enum PaymentDepositPolicy {
  PAY_AT_SALON
  OPTIONAL_DEPOSIT
  REQUIRED_DEPOSIT
  FUTURE_ONLINE
  MANUAL_INSTAPAY
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  level       Int
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  module      String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  phone        String?
  passwordHash String   @map("password_hash")
  roleId       String   @map("role_id") @db.Uuid
  branchId     String?  @map("branch_id") @db.Uuid
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  role   Role    @relation(fields: [roleId], references: [id], onDelete: Restrict)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  branchAccesses UserBranchAccess[]

  systemSettingsUpdates SystemSettings[]       @relation("SystemSettingsUpdatedBy")
  createdBookingSlots   BookingSlot[]          @relation("BookingSlotCreatedBy")
  createdBookings       Booking[]              @relation("BookingCreatedBy")
  handledChangeRequests BookingChangeRequest[] @relation("BookingChangeRequestHandledBy")
  recordedPayments      Payment[]              @relation("PaymentRecordedBy")
  createdInvoices       Invoice[]              @relation("InvoiceCreatedBy")
  updatedSiteContents   SiteContent[]          @relation("SiteContentUpdatedBy")
  websiteContentUpdates WebsiteContentSection[] @relation("WebsiteContentUpdatedBy")
  auditLogs             AuditLog[]
  queueEntriesCreated   QueueEntry[] @relation("QueueEntryCreatedBy")
  queueEntriesUpdated   QueueEntry[] @relation("QueueEntryUpdatedBy")
  cashDrawerSessionsOpened  CashDrawerSession[] @relation("CashDrawerOpenedBy")
  cashDrawerSessionsClosed  CashDrawerSession[] @relation("CashDrawerClosedBy")
  cashDrawerMovementsCreated CashDrawerMovement[] @relation("CashDrawerMovementCreatedBy")
  dailyClosingsClosed   DailyClosing[] @relation("DailyClosingClosedBy")
  whatsAppTemplatesCreated WhatsAppTemplate[] @relation("WhatsAppTemplateCreatedBy")
  whatsAppTemplatesUpdated WhatsAppTemplate[] @relation("WhatsAppTemplateUpdatedBy")
  reviewsCreated           Review[]           @relation("ReviewCreatedBy")
  reviewsUpdated           Review[]           @relation("ReviewUpdatedBy")
  galleryItemsUploaded     GalleryItem[]      @relation("GalleryItemUploadedBy")
  staffProfiles            StaffProfile[]
  refreshTokens            DashboardRefreshToken[]

  @@index([roleId])
  @@index([branchId])
  @@map("users")
}

/// Dashboard user access to one or more branches (default branch remains `User.branchId`).
model UserBranchAccess {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@index([branchId])
  @@map("user_branch_access")
}

/// Dashboard sessions: opaque refresh tokens (stored hashed, rotated on every use).
model DashboardRefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  familyId     String    @map("family_id") @db.Uuid
  expiresAt    DateTime  @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  lastUsedAt   DateTime? @map("last_used_at")
  revokedAt    DateTime? @map("revoked_at")
  revokedReason String?  @map("revoked_reason")
  userAgent    String?   @map("user_agent")
  ipAddress    String?   @map("ip_address")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("dashboard_refresh_tokens")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String
  module    String
  entityId  String?  @map("entity_id")
  oldValue  Json?    @map("old_value")
  newValue  Json?    @map("new_value")
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([module, action, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([entityId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

// --- Sprint 3: Catalog ---

model ServiceCategory {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  imageUrl    String?  @map("image_url")
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  services Service[]

  @@map("service_categories")
}

model Service {
  id                  String           @id @default(uuid()) @db.Uuid
  categoryId          String           @map("category_id") @db.Uuid
  name                String
  /// Arabic display/search name for the front-desk picker (spec v2 §3a).
  nameAr String? @map("name_ar")
  /// Extra search words (e.g. "mani", "صبغة") for the front-desk picker.
  searchAliases String[] @default([]) @map("search_aliases")
  description         String?
  shortDescription    String?          @map("short_description")
  /// Primary website image from the central Gallery (Media Library).
  imageMediaId        String?          @map("image_media_id") @db.Uuid
  imageUrl            String?          @map("image_url")
  imageKey            String?          @map("image_key")
  imageAlt            String?          @map("image_alt")
  displayOrder        Int              @default(0) @map("display_order")
  isFeatured          Boolean          @default(false) @map("is_featured")
  badgeLabel          String?          @map("badge_label")
  priceDisplayType    PriceDisplayType @map("price_display_type")
  basePrice           Decimal?         @map("base_price") @db.Decimal(12, 2)
  basePriceMax        Decimal?         @map("base_price_max") @db.Decimal(12, 2)
  durationMinutes     Int?             @map("duration_minutes")
  /// Processing-time model: minutes inside the service during which the stylist is free
  /// (colour developing, mask setting). 0 = stylist is hands-on the whole time.
  processingMinutes   Int              @default(0) @map("processing_minutes")
  /// Hands-on minutes before the processing window starts (application time).
  processingStartsAfterMinutes Int     @default(0) @map("processing_starts_after_minutes")
  isTaxable           Boolean          @default(true) @map("is_taxable")
  bookingAvailability Boolean          @default(true) @map("booking_availability")
  preparationNotes    String?          @map("preparation_notes")
  aftercareNotes      String?          @map("aftercare_notes")
  isActive            Boolean          @default(true) @map("is_active")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  category        ServiceCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  imageMedia      GalleryItem?     @relation("ServiceGalleryImage", fields: [imageMediaId], references: [id], onDelete: Restrict)
  branches        ServiceBranch[]
  variants        ServiceVariant[]
  benefits        ServiceBenefit[]
  packageServices PackageService[]
  bundleServices  BundleService[]
  bookingItems    BookingItem[]
  relatedReviews  Review[]         @relation("ReviewRelatedService")
  staffProfileServices StaffProfileService[]

  @@index([categoryId, isActive])
  @@map("services")
}

model ServiceBenefit {
  id           String   @id @default(uuid()) @db.Uuid
  serviceId    String   @map("service_id") @db.Uuid
  label        String
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, isActive, displayOrder])
  @@map("service_benefits")
}

model ServiceBranch {
  serviceId String @map("service_id") @db.Uuid
  branchId  String @map("branch_id") @db.Uuid

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([serviceId, branchId])
  @@index([branchId])
  @@map("service_branches")
}

model ServiceVariant {
  id              String   @id @default(uuid()) @db.Uuid
  serviceId       String   @map("service_id") @db.Uuid
  name            String
  /// Arabic display/search name for the front-desk picker (spec v2 §3a).
  nameAr String? @map("name_ar")
  /// Extra search words (e.g. "mani", "صبغة") for the front-desk picker.
  searchAliases String[] @default([]) @map("search_aliases")
  description     String?
  price           Decimal  @db.Decimal(12, 2)
  durationMinutes Int      @map("duration_minutes")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  service      Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  bookingItems BookingItem[]

  @@index([serviceId, isActive])
  @@map("service_variants")
}

model Package {
  id               String    @id @default(uuid()) @db.Uuid
  name             String
  /// Arabic display/search name for the front-desk picker (spec v2 §3a).
  nameAr String? @map("name_ar")
  /// Extra search words (e.g. "mani", "صبغة") for the front-desk picker.
  searchAliases String[] @default([]) @map("search_aliases")
  description      String?
  shortDescription String?   @map("short_description")
  imageUrl         String?   @map("image_url")
  originalPrice    Decimal   @map("original_price") @db.Decimal(12, 2)
  packagePrice     Decimal   @map("package_price") @db.Decimal(12, 2)
  durationMinutes  Int?      @map("duration_minutes")
  startDate        DateTime? @map("start_date") @db.Date
  endDate          DateTime? @map("end_date") @db.Date
  isTaxable        Boolean   @default(true) @map("is_taxable")
  isActive         Boolean   @default(true) @map("is_active")
  isFeatured       Boolean   @default(false) @map("is_featured")
  badgeLabel       String?   @map("badge_label")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  services     PackageService[]
  branches     PackageBranch[]
  features     PackageFeature[]
  bookingItems BookingItem[]

  @@index([isActive])
  @@index([isFeatured])
  @@map("packages")
}

model PackageFeature {
  id           String   @id @default(uuid()) @db.Uuid
  packageId    String   @map("package_id") @db.Uuid
  label        String
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId, isActive, displayOrder])
  @@map("package_features")
}

model PackageService {
  packageId String @map("package_id") @db.Uuid
  serviceId String @map("service_id") @db.Uuid
  sortOrder Int    @default(0) @map("sort_order")

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@id([packageId, serviceId])
  @@index([serviceId])
  @@map("package_services")
}

model PackageBranch {
  packageId String @map("package_id") @db.Uuid
  branchId  String @map("branch_id") @db.Uuid

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([packageId, branchId])
  @@index([branchId])
  @@map("package_branches")
}

model Bundle {
  id              String     @id @default(uuid()) @db.Uuid
  name            String
  description     String?
  bundleType      BundleType @map("bundle_type")
  price           Decimal    @db.Decimal(12, 2)
  rules           Json?
  selectableCount Int        @map("selectable_count")
  startDate       DateTime?  @map("start_date") @db.Date
  endDate         DateTime?  @map("end_date") @db.Date
  isActive        Boolean    @default(true) @map("is_active")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  services     BundleService[]
  bookingItems BookingItem[]

  @@index([isActive])
  @@map("bundles")
}

model BundleService {
  bundleId  String @map("bundle_id") @db.Uuid
  serviceId String @map("service_id") @db.Uuid
  sortOrder Int    @default(0) @map("sort_order")

  bundle  Bundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@id([bundleId, serviceId])
  @@index([serviceId])
  @@map("bundle_services")
}

model Offer {
  id                  String            @id @default(uuid()) @db.Uuid
  name                String
  description         String?
  offerCode           String?           @unique @map("offer_code")
  discountType        OfferDiscountType @map("discount_type")
  discountValue       Decimal           @map("discount_value") @db.Decimal(12, 4)
  startDate           DateTime          @map("start_date") @db.Date
  endDate             DateTime          @map("end_date") @db.Date
  usageLimit          Int?              @map("usage_limit")
  perClientUsageLimit Int?              @map("per_client_usage_limit")
  minimumSpend        Decimal?          @map("minimum_spend") @db.Decimal(12, 2)
  appliesTo           OfferAppliesTo    @default(ALL) @map("applies_to")
  isActive            Boolean           @default(true) @map("is_active")
  eligibilityRules    Json?             @map("eligibility_rules")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("offers")
}

model ServiceEnhancement {
  id               String   @id @default(uuid()) @db.Uuid
  title            String
  /// Arabic display/search name for the front-desk picker (spec v2 §3a).
  nameAr String? @map("name_ar")
  /// Extra search words (e.g. "mani", "صبغة") for the front-desk picker.
  searchAliases String[] @default([]) @map("search_aliases")
  shortDescription String?  @map("short_description")
  price            Decimal? @db.Decimal(12, 2)
  durationMinutes  Int?     @map("duration_minutes")
  imageUrl         String?  @map("image_url")
  displayOrder     Int      @default(0) @map("display_order")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  bookingItems BookingItem[]
  invoiceLines InvoiceLine[]

  @@index([isActive, displayOrder])
  @@map("service_enhancements")
}

enum PriceDisplayType {
  FIXED
  STARTS_FROM
  RANGE
  CONTACT
  HIDDEN
}

enum BundleType {
  FIXED
  FLEXIBLE
  QUANTITY
  MEMBERSHIP_STYLE
}

enum OfferDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  SERVICE
  PACKAGE
  BUNDLE
  FIRST_BOOKING
  SEASONAL
  PROMO_CODE
}

enum OfferAppliesTo {
  ALL
  SERVICES
  PACKAGES
}

enum BookingSlotStatus {
  AVAILABLE
  PENDING
  FILLED
  BLOCKED
  CLOSED
}

model BookingSlot {
  id               String            @id @default(uuid()) @db.Uuid
  branchId         String            @map("branch_id") @db.Uuid
  date             DateTime          @db.Date
  startTime        DateTime          @map("start_time") @db.Time(0)
  endTime          DateTime          @map("end_time") @db.Time(0)
  capacity         Int
  bookedCount      Int               @default(0) @map("booked_count")
  status           BookingSlotStatus
  isOnlineBookable Boolean           @default(true) @map("is_online_bookable")
  /// Internal same-day capacity bucket for walk-in queue bookings (never listed for public online booking).
  isWalkInBucket   Boolean           @default(false) @map("is_walk_in_bucket")
  notes            String?
  /// Set when a Holidays & Closures entry closed this slot; cleared (and slot reopened) when the closure is removed.
  closedByClosureId String?          @map("closed_by_closure_id") @db.Uuid
  createdByUserId  String?           @map("created_by_user_id") @db.Uuid
  deletedAt        DateTime?         @map("deleted_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  branch    Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdBy User?  @relation("BookingSlotCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  closedByClosure BranchClosure? @relation(fields: [closedByClosureId], references: [id], onDelete: SetNull)

  bookings             Booking[]
  changeRequestTargets BookingChangeRequest[] @relation("ChangeRequestTargetSlot")

  @@index([branchId, date])
  @@index([branchId, date, startTime])
  @@index([createdByUserId])
  @@index([deletedAt])
  @@index([closedByClosureId])
  @@map("booking_slots")
}

/// Holidays & closures: a date range on which a branch takes no appointments.
/// Slot generation skips these days and existing slots in the range are CLOSED.
model BranchClosure {
  id              String   @id @default(uuid()) @db.Uuid
  branchId        String   @map("branch_id") @db.Uuid
  startDate       DateTime @map("start_date") @db.Date
  endDate         DateTime @map("end_date") @db.Date
  reason          String
  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  branch Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  slots  BookingSlot[]

  @@index([branchId, startDate, endDate])
  @@map("branch_closures")
}

// --- Sprint 5: Clients + bookings ---

enum ClientIdentityProvider {
  GOOGLE
  FACEBOOK
}

model Client {
  id                  String    @id @default(uuid()) @db.Uuid
  fullName            String    @map("full_name")
  phone               String
  email               String?
  profileImageUrl     String?   @map("profile_image_url")
  gender              String?
  birthDate           DateTime? @map("birth_date") @db.Date
  preferredBranchId   String?   @map("preferred_branch_id") @db.Uuid
  notes               String?
  allergiesOrWarnings String?   @map("allergies_or_warnings")
  tags                String[]  @default([])
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  preferredBranch Branch?                @relation("ClientPreferredBranch", fields: [preferredBranchId], references: [id], onDelete: SetNull)
  identities      ClientIdentity[]
  bookings        Booking[]
  changeRequests  BookingChangeRequest[]
  payments        Payment[]
  invoices        Invoice[]
  reviews         Review[]
  queueEntries    QueueEntry[]

  @@unique([phone])
  @@map("clients")
  loyaltyTransactions LoyaltyTransaction[]
}

enum ClientOtpPurpose {
  LOGIN
  SIGN_IN
  REGISTER
}

model ClientOtpCode {
  id         String           @id @default(uuid()) @db.Uuid
  phone      String
  codeHash   String           @map("code_hash")
  expiresAt  DateTime         @map("expires_at")
  consumedAt DateTime?        @map("consumed_at")
  attempts   Int              @default(0)
  purpose    ClientOtpPurpose @default(LOGIN)
  createdAt  DateTime         @default(now()) @map("created_at")

  @@index([phone, purpose, createdAt(sort: Desc)])
  @@index([expiresAt])
