enum StaffScheduleExceptionType {
  DAY_OFF
  CUSTOM_HOURS
  EXTRA_SHIFT
}

model StaffProfile {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  branchId       String   @map("branch_id") @db.Uuid
  displayName    String   @map("display_name")
  bio            String?
  avatarImageId  String?  @map("avatar_image_id") @db.Uuid
  isBookable     Boolean  @default(true) @map("is_bookable")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  avatarImage  GalleryItem? @relation("StaffProfileAvatar", fields: [avatarImageId], references: [id], onDelete: SetNull)
  services     StaffProfileService[]
  schedules    StaffSchedule[]
  exceptions   StaffScheduleException[]
  bookingItems BookingItem[]

  @@unique([userId, branchId])
  @@index([branchId, isActive])
  @@map("staff_profiles")
}

/// Staff member ↔ service capability (which catalog services this staff can perform).
model StaffProfileService {
  id             String   @id @default(uuid()) @db.Uuid
  staffProfileId String   @map("staff_profile_id") @db.Uuid
  serviceId      String   @map("service_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  staffProfile StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([staffProfileId, serviceId])
  @@index([serviceId])
  @@map("staff_profile_services")
}

model StaffSchedule {
  id              String   @id @default(uuid()) @db.Uuid
  staffProfileId  String   @map("staff_profile_id") @db.Uuid
  branchId        String   @map("branch_id") @db.Uuid
  /// 0 = Sunday … 6 = Saturday (Cairo calendar day).
  dayOfWeek       Int      @map("day_of_week")
  startTime       DateTime @map("start_time") @db.Time(0)
  endTime         DateTime @map("end_time") @db.Time(0)
  breakStartTime  DateTime? @map("break_start_time") @db.Time(0)
  breakEndTime    DateTime? @map("break_end_time") @db.Time(0)
  isWorking       Boolean  @default(true) @map("is_working")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  staffProfile StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@unique([staffProfileId, branchId, dayOfWeek])
  @@index([branchId])
  @@map("staff_schedules")
}

model StaffScheduleException {
  id             String                    @id @default(uuid()) @db.Uuid
  staffProfileId String                  @map("staff_profile_id") @db.Uuid
  branchId       String                   @map("branch_id") @db.Uuid
  date           DateTime                  @db.Date
  type           StaffScheduleExceptionType
  startTime      DateTime?                 @map("start_time") @db.Time(0)
  endTime        DateTime?                 @map("end_time") @db.Time(0)
  reason         String?
  createdAt      DateTime                  @default(now()) @map("created_at")
  updatedAt      DateTime                  @updatedAt @map("updated_at")

  staffProfile StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@unique([staffProfileId, date])
  @@index([branchId, date])
  @@map("staff_schedule_exceptions")
}

model Booking {
  id              String        @id @default(uuid()) @db.Uuid
  clientId        String        @map("client_id") @db.Uuid
  branchId        String        @map("branch_id") @db.Uuid
  slotId          String        @map("slot_id") @db.Uuid
  status          BookingStatus
  source          BookingSource
  subtotal        Decimal       @db.Decimal(12, 2)
  discountAmount  Decimal       @default(0) @map("discount_amount") @db.Decimal(12, 2)
  discountReason  String?       @map("discount_reason")
  appliedOfferId  String?       @map("applied_offer_id") @db.Uuid
  appliedPromoCode String?      @map("applied_promo_code")
  promoSnapshot   Json?         @map("promo_snapshot")
  vatRate         Decimal       @map("vat_rate") @db.Decimal(6, 5)
  vatAmount       Decimal       @map("vat_amount") @db.Decimal(12, 2)
  totalAmount     Decimal       @map("total_amount") @db.Decimal(12, 2)
  clientNotes     String?       @map("client_notes")
  adminNotes      String?       @map("admin_notes")
  createdByUserId String?       @map("created_by_user_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  client         Client                 @relation(fields: [clientId], references: [id], onDelete: Restrict)
  branch         Branch                 @relation(fields: [branchId], references: [id], onDelete: Restrict)
  slot           BookingSlot            @relation(fields: [slotId], references: [id], onDelete: Restrict)
  createdByUser  User?                  @relation("BookingCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  items          BookingItem[]
  changeRequests BookingChangeRequest[]
  payments       Payment[]
  invoices       Invoice[]
  reviews        Review[]
  queueEntries   QueueEntry[]
  notificationLogs NotificationLog[]

  @@index([clientId, createdAt(sort: Desc)])
  @@index([branchId, status, slotId])
  @@index([slotId])
  @@map("bookings")
}

model BookingItem {
  id                      String          @id @default(uuid()) @db.Uuid
  bookingId               String          @map("booking_id") @db.Uuid
  itemType                BookingItemType @map("item_type")
  serviceId               String?         @map("service_id") @db.Uuid
  serviceVariantId        String?         @map("service_variant_id") @db.Uuid
  packageId               String?         @map("package_id") @db.Uuid
  bundleId                String?         @map("bundle_id") @db.Uuid
  serviceEnhancementId    String?         @map("service_enhancement_id") @db.Uuid
  nameSnapshot            String          @map("name_snapshot")
  priceSnapshot           Decimal         @map("price_snapshot") @db.Decimal(12, 2)
  /// Discount on this line only (EGP, total for the line). Receipt-level discounts live on Booking.discountAmount.
  discountAmount          Decimal         @default(0) @map("discount_amount") @db.Decimal(12, 2)
  discountReason          String?         @map("discount_reason")
  durationMinutesSnapshot Int             @map("duration_minutes_snapshot")
  quantity                Int             @default(1)
  /// Optional JSON: e.g. `{ "selectedServiceIds": ["uuid"] }` for flexible bundles (Sprint 5).
  lineMetadata            Json?           @map("line_metadata")
  lineStatus              BookingItemLineStatus @default(PENDING) @map("line_status")
  staffProfileId          String?         @map("staff_profile_id") @db.Uuid
  startedAt               DateTime?       @map("started_at")
  completedAt             DateTime?       @map("completed_at")
  createdAt               DateTime        @default(now()) @map("created_at")
  updatedAt               DateTime        @updatedAt @map("updated_at")

  booking        Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service        Service?        @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  serviceVariant ServiceVariant? @relation(fields: [serviceVariantId], references: [id], onDelete: SetNull)
  package        Package?        @relation(fields: [packageId], references: [id], onDelete: SetNull)
  bundle         Bundle?         @relation(fields: [bundleId], references: [id], onDelete: SetNull)
  serviceEnhancement ServiceEnhancement? @relation(fields: [serviceEnhancementId], references: [id], onDelete: SetNull)
  staffProfile   StaffProfile?   @relation(fields: [staffProfileId], references: [id], onDelete: SetNull)
  invoiceLines   InvoiceLine[]

  @@index([bookingId])
  @@index([staffProfileId, lineStatus])
  @@map("booking_items")
}

model BookingChangeRequest {
  id              String                     @id @default(uuid()) @db.Uuid
  bookingId       String                     @map("booking_id") @db.Uuid
  clientId        String                     @map("client_id") @db.Uuid
  requestType     BookingChangeRequestType   @map("request_type")
  requestedSlotId String?                    @map("requested_slot_id") @db.Uuid
  reason          String?
  status          BookingChangeRequestStatus
  handledByUserId String?                    @map("handled_by_user_id") @db.Uuid
  handledAt       DateTime?                  @map("handled_at")
  createdAt       DateTime                   @default(now()) @map("created_at")
  updatedAt       DateTime                   @updatedAt @map("updated_at")

  booking       Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  client        Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  requestedSlot BookingSlot? @relation("ChangeRequestTargetSlot", fields: [requestedSlotId], references: [id], onDelete: SetNull)
  handledByUser    User?             @relation("BookingChangeRequestHandledBy", fields: [handledByUserId], references: [id], onDelete: SetNull)
  notificationLogs NotificationLog[]

  @@index([bookingId, status])
  @@index([clientId, createdAt(sort: Desc)])
  @@map("booking_change_requests")
}

/// Operational same-day visit queue (MVP). Separate from scheduled Booking rows.
model QueueEntry {
  id                     String           @id @default(uuid()) @db.Uuid
  branchId               String           @map("branch_id") @db.Uuid
  bookingId              String?          @map("booking_id") @db.Uuid
  clientId               String?          @map("client_id") @db.Uuid
  source                 QueueEntrySource
  status                 QueueEntryStatus
  clientNameSnapshot     String           @map("client_name_snapshot")
  clientPhoneSnapshot    String?          @map("client_phone_snapshot")
  serviceSummarySnapshot String?          @map("service_summary_snapshot")
  itemsSnapshot          Json?            @map("items_snapshot")
  notes                  String?
  /// Set when the visit was closed while the invoice still had a balance (spec v2 §4, SOFT rule).
  closedWithBalanceReason String?         @map("closed_with_balance_reason")
  checkedInAt            DateTime         @map("checked_in_at")
  startedAt              DateTime?        @map("started_at")
  completedAt            DateTime?        @map("completed_at")
  cancelledAt            DateTime?        @map("cancelled_at")
  createdByUserId        String           @map("created_by_user_id") @db.Uuid
  updatedByUserId        String?          @map("updated_by_user_id") @db.Uuid
  createdAt              DateTime         @default(now()) @map("created_at")
  updatedAt              DateTime         @updatedAt @map("updated_at")

  branch        Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  booking       Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  client        Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdByUser User     @relation("QueueEntryCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedByUser User?    @relation("QueueEntryUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([branchId, checkedInAt(sort: Desc)])
  @@index([bookingId])
  @@index([branchId, status])
  @@map("queue_entries")
}

// --- Sprint 7: Payments & invoices (manual only; no online gateway) ---

enum PaymentMethod {
  CASH
  CARD
  INSTAPAY
  MOBILE_WALLET
  BANK_TRANSFER
  /// Loyalty redemption (points or the free-service reward). Created only by the loyalty service.
  LOYALTY
}

enum LoyaltyTransactionType {
  REDEEM_POINTS
  REWARD
  ADJUST
}

/// Loyalty ledger. Earned points are *computed* from paid payments; only redemptions, visit
/// rewards used and manual adjustments are stored. A redemption counts while its payment is PAID.
model LoyaltyTransaction {
  id              String                 @id @default(uuid()) @db.Uuid
  clientId        String                 @map("client_id") @db.Uuid
  type            LoyaltyTransactionType
  /// Signed: negative for REDEEM_POINTS, +/- for ADJUST, 0 for REWARD.
  points          Int
  amountEgp       Decimal?               @map("amount_egp") @db.Decimal(12, 2)
  paymentId       String?                @unique @map("payment_id") @db.Uuid
  bookingId       String?                @map("booking_id") @db.Uuid
  note            String?
  createdByUserId String?                @map("created_by_user_id") @db.Uuid
  createdAt       DateTime               @default(now()) @map("created_at")

  client  Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
  @@map("loyalty_transactions")
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  REFUNDED
  CANCELLED
}

enum InvoiceStatus {
  FINALIZED
  CANCELLED
}

/// Singleton row for human-readable invoice numbers (Sprint 7). Fixed `id` in seed.
model InvoiceNumberSequence {
  id        String @id @db.Uuid
  nextValue Int    @default(0) @map("next_value")

  @@map("invoice_number_sequence")
}

model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  bookingId       String        @map("booking_id") @db.Uuid
  clientId        String        @map("client_id") @db.Uuid
  amount          Decimal       @db.Decimal(12, 2)
  method          PaymentMethod
  status          PaymentStatus
  reference       String?
  paidAt          DateTime?     @map("paid_at")
  createdByUserId String?       @map("created_by_user_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  booking       Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  client        Client  @relation(fields: [clientId], references: [id], onDelete: Restrict)
  createdByUser User?   @relation("PaymentRecordedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([clientId])
  @@map("payments")
  loyaltyTransaction LoyaltyTransaction?
}

model Invoice {
  id              String         @id @default(uuid()) @db.Uuid
  invoiceNumber   String         @unique @map("invoice_number")
  bookingId       String         @map("booking_id") @db.Uuid
  clientId        String         @map("client_id") @db.Uuid
  subtotal        Decimal        @db.Decimal(12, 2)
  discountAmount  Decimal        @default(0) @map("discount_amount") @db.Decimal(12, 2)
  discountReason  String?        @map("discount_reason")
  vatRate         Decimal        @map("vat_rate") @db.Decimal(6, 5)
  vatAmount       Decimal        @map("vat_amount") @db.Decimal(12, 2)
  totalAmount     Decimal        @map("total_amount") @db.Decimal(12, 2)
  paidAmount      Decimal        @default(0) @map("paid_amount") @db.Decimal(12, 2)
  remainingAmount Decimal        @map("remaining_amount") @db.Decimal(12, 2)
  status          InvoiceStatus
  paymentMethod   PaymentMethod? @map("payment_method")
  createdByUserId String?        @map("created_by_user_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  booking       Booking       @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  client        Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  createdByUser User?         @relation("InvoiceCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  lines         InvoiceLine[]

  @@index([bookingId])
  @@index([clientId, createdAt(sort: Desc)])
  @@map("invoices")
}

model InvoiceLine {
  id                      String          @id @default(uuid()) @db.Uuid
  invoiceId               String          @map("invoice_id") @db.Uuid
  sortOrder               Int             @map("sort_order")
  itemType                BookingItemType @map("item_type")
  serviceId               String?         @map("service_id") @db.Uuid
  serviceVariantId        String?         @map("service_variant_id") @db.Uuid
  packageId               String?         @map("package_id") @db.Uuid
  bundleId                String?         @map("bundle_id") @db.Uuid
  serviceEnhancementId    String?         @map("service_enhancement_id") @db.Uuid
  nameSnapshot            String          @map("name_snapshot")
  priceSnapshot           Decimal         @map("price_snapshot") @db.Decimal(12, 2)
  discountAmount          Decimal         @default(0) @map("discount_amount") @db.Decimal(12, 2)
  durationMinutesSnapshot Int             @map("duration_minutes_snapshot")
  quantity                Int             @default(1)
  lineMetadata            Json?           @map("line_metadata")
  bookingItemId           String?         @map("booking_item_id") @db.Uuid

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  serviceEnhancement ServiceEnhancement? @relation(fields: [serviceEnhancementId], references: [id], onDelete: SetNull)
  bookingItem BookingItem? @relation(fields: [bookingItemId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([bookingItemId])
  @@map("invoice_lines")
}

enum CashDrawerSessionStatus {
  OPEN
  CLOSED
}

enum CashDrawerMovementType {
  CASH_IN
  CASH_OUT
  ADJUSTMENT
}

enum DailyClosingStatus {
  DRAFT
  CLOSED
}

/// One cash drawer record per branch calendar day (status OPEN then CLOSED).
model CashDrawerSession {
  id               String                  @id @default(uuid()) @db.Uuid
  branchId         String                  @map("branch_id") @db.Uuid
  businessDate     DateTime                @map("business_date") @db.Date
  status           CashDrawerSessionStatus
  openingBalance   Decimal                 @map("opening_balance") @db.Decimal(12, 2)
  expectedCash     Decimal                 @map("expected_cash") @db.Decimal(12, 2)
  countedCash      Decimal?                @map("counted_cash") @db.Decimal(12, 2)
  cashDifference   Decimal?                @map("cash_difference") @db.Decimal(12, 2)
  openedByUserId   String                  @map("opened_by_user_id") @db.Uuid
  openedAt         DateTime                @default(now()) @map("opened_at")
  closedByUserId   String?                 @map("closed_by_user_id") @db.Uuid
  closedAt         DateTime?               @map("closed_at")
  notes            String?
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")

  branch    Branch               @relation(fields: [branchId], references: [id], onDelete: Restrict)
  openedBy  User                 @relation("CashDrawerOpenedBy", fields: [openedByUserId], references: [id], onDelete: Restrict)
  closedBy  User?                @relation("CashDrawerClosedBy", fields: [closedByUserId], references: [id], onDelete: SetNull)
  movements    CashDrawerMovement[]
  dailyClosings DailyClosing[]

  @@unique([branchId, businessDate])
  @@index([branchId, status])
  @@map("cash_drawer_sessions")
}

model CashDrawerMovement {
  id              String                 @id @default(uuid()) @db.Uuid
  drawerSessionId String                 @map("drawer_session_id") @db.Uuid
  branchId        String                 @map("branch_id") @db.Uuid
  type            CashDrawerMovementType
  amount          Decimal                @db.Decimal(12, 2)
  reason          String
  notes           String?
  createdByUserId String                 @map("created_by_user_id") @db.Uuid
  createdAt       DateTime               @default(now()) @map("created_at")

  session   CashDrawerSession @relation(fields: [drawerSessionId], references: [id], onDelete: Cascade)
  branch    Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdBy User              @relation("CashDrawerMovementCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([drawerSessionId, createdAt(sort: Desc)])
  @@index([branchId])
  @@map("cash_drawer_movements")
}

model DailyClosing {
  id                        String             @id @default(uuid()) @db.Uuid
  branchId                  String             @map("branch_id") @db.Uuid
  businessDate              DateTime           @map("business_date") @db.Date
  status                    DailyClosingStatus
  cashDrawerSessionId       String?            @map("cash_drawer_session_id") @db.Uuid
  closedByUserId            String?            @map("closed_by_user_id") @db.Uuid
  closedAt                  DateTime?          @map("closed_at")
  totalInvoices             Decimal            @default(0) @map("total_invoices") @db.Decimal(12, 2)
  grossSales                Decimal            @default(0) @map("gross_sales") @db.Decimal(12, 2)
  totalCollected            Decimal            @default(0) @map("total_collected") @db.Decimal(12, 2)
  cashCollected             Decimal            @default(0) @map("cash_collected") @db.Decimal(12, 2)
  cardCollected             Decimal            @default(0) @map("card_collected") @db.Decimal(12, 2)
  instapayCollected         Decimal            @default(0) @map("instapay_collected") @db.Decimal(12, 2)
  walletCollected           Decimal            @default(0) @map("wallet_collected") @db.Decimal(12, 2)
  bankTransferCollected     Decimal            @default(0) @map("bank_transfer_collected") @db.Decimal(12, 2)
  otherCollected            Decimal            @default(0) @map("other_collected") @db.Decimal(12, 2)
  outstandingBalance        Decimal            @default(0) @map("outstanding_balance") @db.Decimal(12, 2)
  expectedCash              Decimal            @default(0) @map("expected_cash") @db.Decimal(12, 2)
  countedCash               Decimal            @default(0) @map("counted_cash") @db.Decimal(12, 2)
  cashDifference            Decimal            @default(0) @map("cash_difference") @db.Decimal(12, 2)
  invoiceCount              Int                @default(0) @map("invoice_count")
  paymentCount              Int                @default(0) @map("payment_count")
  bookingCount              Int                @default(0) @map("booking_count")
  completedBookingCount     Int                @default(0) @map("completed_booking_count")
  inProgressBookingCount    Int                @default(0) @map("in_progress_booking_count")
  cancelledBookingCount     Int                @default(0) @map("cancelled_booking_count")
  queueVisitCount           Int                @default(0) @map("queue_visit_count")
  queueCompletedCount       Int                @default(0) @map("queue_completed_count")
  queueActiveCount          Int                @default(0) @map("queue_active_count")
  notes                     String?
  /// Why the day was closed while visits were still open or invoices unpaid (ALERT policy).
  carryOverReason           String?            @map("carry_over_reason")
  snapshot                  Json
  createdAt                 DateTime           @default(now()) @map("created_at")
  updatedAt                 DateTime           @updatedAt @map("updated_at")

  branch            Branch             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  cashDrawerSession CashDrawerSession? @relation(fields: [cashDrawerSessionId], references: [id], onDelete: SetNull)
  closedBy          User?              @relation("DailyClosingClosedBy", fields: [closedByUserId], references: [id], onDelete: SetNull)

  @@unique([branchId, businessDate])
  @@index([branchId, status])
  @@map("daily_closings")
}

/// Editable WhatsApp message templates for dashboard deep links (SRS §11.4, Sprint 6).
model WhatsAppTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  templateKey String   @unique @map("template_key")
  content     String   @db.Text
  /// JSON array of supported variable names (e.g. clientName, bookingDate) — see API docs.
  variables   Json
  /// Logical category for UI and future automation (e.g. booking_confirmation, payment_received).
  category    String   @default("custom")
  /// Message language (ar | en).
  language    String   @default("ar")
  description String?
  /// Optional JSON object of sample values for preview overrides.
  sampleData  Json?    @map("sample_data")
  isActive    Boolean  @default(true) @map("is_active")
  createdByUserId   String? @map("created_by_user_id") @db.Uuid
  updatedByUserId   String? @map("updated_by_user_id") @db.Uuid
  metaTemplateName   String? @map("meta_template_name")
  metaTemplateStatus String? @map("meta_template_status")
  requiresMetaApproval Boolean @default(false) @map("requires_meta_approval")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  createdBy User? @relation("WhatsAppTemplateCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy User? @relation("WhatsAppTemplateUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([category])
  @@index([language, isActive])
  @@map("whatsapp_templates")
}

/// Central media library row (dashboard “Gallery”). Public URLs live in `imageUrl`.
model GalleryItem {
  id           String   @id @default(uuid()) @db.Uuid
  imageUrl     String   @map("image_url")
  /// Relative storage key under uploads root when file was uploaded via dashboard (e.g. `media/<uuid>.webp`).
  storageKey   String?  @map("storage_key")
  originalName String?  @map("original_name")
  mimeType     String?  @map("mime_type")
  sizeBytes    Int?     @map("size_bytes")
  width        Int?
  height       Int?
  title        String?
  altText      String?  @map("alt_text")
  category     String?
  description  String?
  tags         String[] @default([])
  isFeatured   Boolean  @default(false) @map("is_featured")
  displayOrder Int      @default(0) @map("display_order")
  /// Legacy flag: shown on public gallery when no explicit homepage-gallery usages exist.
  isActive     Boolean  @default(true) @map("is_active")
  /// Library lifecycle — archived items are hidden from pickers but existing site links may still resolve.
  libraryStatus GalleryItemLibraryStatus @default(ACTIVE) @map("library_status")
  uploadedByUserId String? @map("uploaded_by_user_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  uploadedBy User? @relation("GalleryItemUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  mediaUsages MediaUsage[]
  servicesAsPrimaryImage Service[] @relation("ServiceGalleryImage")
  staffProfileAvatars StaffProfile[] @relation("StaffProfileAvatar")
  websiteContentPrimaryFor   WebsiteContentSection[] @relation("WebsiteContentPrimaryImage")
  websiteContentSecondaryFor WebsiteContentSection[] @relation("WebsiteContentSecondaryImage")

  @@index([isActive, displayOrder])
  @@index([category, isActive])
  @@index([libraryStatus, createdAt(sort: Desc)])
  @@map("gallery_items")
}

enum GalleryItemLibraryStatus {
  ACTIVE
  ARCHIVED
}

/// Tracks where a gallery / media asset is used (services, homepage sections, etc.).
model MediaUsage {
  id            String   @id @default(uuid()) @db.Uuid
  galleryItemId String   @map("gallery_item_id") @db.Uuid
  usageType     String   @map("usage_type")
  entityType    String?  @map("entity_type")
  entityId      String?  @map("entity_id") @db.Uuid
  sectionKey    String?  @map("section_key")
  isPrimary     Boolean  @default(false) @map("is_primary")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  galleryItem GalleryItem @relation(fields: [galleryItemId], references: [id], onDelete: Cascade)

  @@index([galleryItemId])
  @@index([usageType, entityId])
  @@map("media_usages")
}

model Review {
  id               String       @id @default(uuid()) @db.Uuid
  clientId         String?      @map("client_id") @db.Uuid
  bookingId        String?      @map("booking_id") @db.Uuid
  relatedServiceId String?      @map("related_service_id") @db.Uuid
  /// Display name for curated testimonials; falls back to linked client when null.
  clientName       String?      @map("client_name")
  clientTitle      String?      @map("client_title")
  serviceName      String?      @map("service_name")
  branchId         String?      @map("branch_id") @db.Uuid
  rating           Int
  comment          String?
  status           ReviewStatus @default(PENDING)
  isActive         Boolean      @default(true) @map("is_active")
  /// At most one review may be true at a time (DB partial unique index on constant WHERE show_on_homepage).
  showOnHomepage   Boolean      @default(false) @map("show_on_homepage")
  displayOrder     Int          @default(0) @map("display_order")
  source           String?
  createdByUserId  String?      @map("created_by_user_id") @db.Uuid
  updatedByUserId  String?      @map("updated_by_user_id") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  client          Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  booking         Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  relatedService  Service? @relation("ReviewRelatedService", fields: [relatedServiceId], references: [id], onDelete: SetNull)
  branch          Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdByUser   User?    @relation("ReviewCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUser   User?    @relation("ReviewUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([isActive, showOnHomepage, updatedAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([clientId])
  @@index([bookingId])
  @@index([branchId])
  @@map("reviews")
}

model SiteContent {
  id              String   @id @db.Uuid
  homeHero        Json     @map("home_hero")
  aboutSection    Json     @map("about_section")
  contactSection  Json     @map("contact_section")
  footerSection   Json     @map("footer_section")
  socialLinks     Json     @map("social_links")
  seoDefaults     Json     @map("seo_defaults")
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  updatedByUser User? @relation("SiteContentUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@map("site_content")
}

/// Dashboard-managed public website copy and imagery (non-catalog). Images reference `GalleryItem`.
model WebsiteContentSection {
  id                     String   @id @default(uuid()) @db.Uuid
  key                    String   @unique
  page                   String
  sectionType            String   @map("section_type")
  title                  String?
  subtitle               String?
  body                   String?
  eyebrow                String?
  ctaLabel               String?  @map("cta_label")
  ctaHref                String?  @map("cta_href")
  secondaryCtaLabel      String?  @map("secondary_cta_label")
  secondaryCtaHref       String?  @map("secondary_cta_href")
  primaryGalleryItemId   String?  @map("primary_gallery_item_id") @db.Uuid
  secondaryGalleryItemId String?  @map("secondary_gallery_item_id") @db.Uuid
  content                Json?
  isVisible              Boolean  @default(true) @map("is_visible")
  displayOrder           Int      @default(0) @map("display_order")
  /// When true, visibility cannot be turned off in dashboard / public always treats as visible.
  isRequired             Boolean  @default(false) @map("is_required")
  updatedByUserId        String?  @map("updated_by_user_id") @db.Uuid
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  primaryGalleryItem   GalleryItem? @relation("WebsiteContentPrimaryImage", fields: [primaryGalleryItemId], references: [id], onDelete: SetNull)
  secondaryGalleryItem GalleryItem? @relation("WebsiteContentSecondaryImage", fields: [secondaryGalleryItemId], references: [id], onDelete: SetNull)
  updatedByUser        User?        @relation("WebsiteContentUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([page, displayOrder])
  @@map("website_content_sections")
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  HIDDEN
}

enum NotificationChannel {
  WHATSAPP
}

enum NotificationType {
  BOOKING_CONFIRMATION
  BOOKING_REQUEST_RECEIVED
  BOOKING_REJECTED
  BOOKING_RESCHEDULED
  APPOINTMENT_REMINDER
  APPOINTMENT_REMINDER_90M
  BOOKING_CANCELLATION
  CHANGE_REQUEST_UPDATE
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model NotificationLog {
  id                String               @id @default(uuid()) @db.Uuid
  branchId          String?              @map("branch_id") @db.Uuid
  bookingId         String?              @map("booking_id") @db.Uuid
  changeRequestId   String?              @map("change_request_id") @db.Uuid
  channel           NotificationChannel
  type              NotificationType
  recipientPhone    String               @map("recipient_phone")
  provider          String               @default("wapilot")
  status            NotificationStatus
  providerMessageId String?              @map("provider_message_id")
  errorMessage      String?              @map("error_message")
  sentAt            DateTime?            @map("sent_at")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  booking       Booking?              @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  changeRequest BookingChangeRequest? @relation(fields: [changeRequestId], references: [id], onDelete: SetNull)

  @@index([bookingId, type, status])
  @@index([changeRequestId, type, status])
  @@index([status, type, createdAt])
  @@map("notification_logs")
}
