generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Minimal branch row for Sprint 1 (User.branchId FK). CRUD APIs in Sprint 2.
model Branch {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  address      String   @default("")
  phone        String   @default("")
  whatsapp     String   @default("")
  mapUrl       String   @default("") @map("map_url")
  workingHours Json?    @map("working_hours")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  users           User[]
  serviceBranches ServiceBranch[]
  packageBranches PackageBranch[]
  bookingSlots    BookingSlot[]
  bookings        Booking[]
  clientsPreferred Client[] @relation("ClientPreferredBranch")

  @@map("branches")
}

/// Singleton global VAT + payment/deposit policy (Sprint 2). One row; fixed id in seed.
model SystemSettings {
  id                    String               @id @db.Uuid
  vatEnabled            Boolean              @map("vat_enabled")
  defaultVatRate        Decimal              @map("default_vat_rate") @db.Decimal(6, 5)
  pricesIncludeVat      Boolean              @map("prices_include_vat")
  showVatOnInvoice      Boolean              @map("show_vat_on_invoice")
  taxRegistrationNumber String?            @map("tax_registration_number")
  paymentDepositPolicy  PaymentDepositPolicy @map("payment_deposit_policy")
  updatedByUserId       String?              @map("updated_by_user_id") @db.Uuid
  updatedAt             DateTime             @updatedAt @map("updated_at")

  updatedBy User? @relation("SystemSettingsUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@map("system_settings")
}

enum PaymentDepositPolicy {
  PAY_AT_SALON
  OPTIONAL_DEPOSIT
  REQUIRED_DEPOSIT
  FUTURE_ONLINE
  MANUAL_INSTAPAY
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  level       Int
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  module      String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  phone        String?
  passwordHash String   @map("password_hash")
  roleId       String   @map("role_id") @db.Uuid
  branchId     String?  @map("branch_id") @db.Uuid
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  role   Role    @relation(fields: [roleId], references: [id], onDelete: Restrict)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  systemSettingsUpdates SystemSettings[] @relation("SystemSettingsUpdatedBy")
  createdBookingSlots   BookingSlot[]    @relation("BookingSlotCreatedBy")
  createdBookings       Booking[]        @relation("BookingCreatedBy")
  handledChangeRequests BookingChangeRequest[] @relation("BookingChangeRequestHandledBy")

  @@index([roleId])
  @@index([branchId])
  @@map("users")
}

// --- Sprint 3: Catalog ---

model ServiceCategory {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  imageUrl    String?  @map("image_url")
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  services Service[]

  @@map("service_categories")
}

model Service {
  id                  String            @id @default(uuid()) @db.Uuid
  categoryId          String            @map("category_id") @db.Uuid
  name                String
  description         String?
  imageUrl            String?           @map("image_url")
  priceDisplayType    PriceDisplayType  @map("price_display_type")
  basePrice           Decimal?          @map("base_price") @db.Decimal(12, 2)
  basePriceMax        Decimal?          @map("base_price_max") @db.Decimal(12, 2)
  durationMinutes     Int?              @map("duration_minutes")
  isTaxable           Boolean           @default(true) @map("is_taxable")
  bookingAvailability Boolean           @default(true) @map("booking_availability")
  preparationNotes    String?         @map("preparation_notes")
  aftercareNotes      String?           @map("aftercare_notes")
  isActive            Boolean           @default(true) @map("is_active")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  category        ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  branches        ServiceBranch[]
  variants        ServiceVariant[]
  packageServices PackageService[]
  bundleServices  BundleService[]
  bookingItems    BookingItem[]

  @@index([categoryId, isActive])
  @@map("services")
}

model ServiceBranch {
  serviceId String @map("service_id") @db.Uuid
  branchId  String @map("branch_id") @db.Uuid

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([serviceId, branchId])
  @@index([branchId])
  @@map("service_branches")
}

model ServiceVariant {
  id              String   @id @default(uuid()) @db.Uuid
  serviceId       String   @map("service_id") @db.Uuid
  name            String
  description     String?
  price           Decimal  @db.Decimal(12, 2)
  durationMinutes Int      @map("duration_minutes")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  bookingItems BookingItem[]

  @@index([serviceId, isActive])
  @@map("service_variants")
}

model Package {
  id             String    @id @default(uuid()) @db.Uuid
  name           String
  description    String?
  imageUrl       String?   @map("image_url")
  originalPrice  Decimal   @map("original_price") @db.Decimal(12, 2)
  packagePrice   Decimal   @map("package_price") @db.Decimal(12, 2)
  durationMinutes Int      @map("duration_minutes")
  startDate      DateTime? @map("start_date") @db.Date
  endDate        DateTime? @map("end_date") @db.Date
  isTaxable      Boolean   @default(true) @map("is_taxable")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  services PackageService[]
  branches PackageBranch[]
  bookingItems BookingItem[]

  @@index([isActive])
  @@map("packages")
}

model PackageService {
  packageId String @map("package_id") @db.Uuid
  serviceId String @map("service_id") @db.Uuid
  sortOrder Int    @default(0) @map("sort_order")

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@id([packageId, serviceId])
  @@index([serviceId])
  @@map("package_services")
}

model PackageBranch {
  packageId String @map("package_id") @db.Uuid
  branchId  String @map("branch_id") @db.Uuid

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([packageId, branchId])
  @@index([branchId])
  @@map("package_branches")
}

model Bundle {
  id               String     @id @default(uuid()) @db.Uuid
  name             String
  description      String?
  bundleType       BundleType @map("bundle_type")
  price            Decimal    @db.Decimal(12, 2)
  rules            Json?
  selectableCount  Int        @map("selectable_count")
  startDate        DateTime?  @map("start_date") @db.Date
  endDate          DateTime?  @map("end_date") @db.Date
  isActive         Boolean    @default(true) @map("is_active")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  services BundleService[]
  bookingItems BookingItem[]

  @@index([isActive])
  @@map("bundles")
}

model BundleService {
  bundleId  String @map("bundle_id") @db.Uuid
  serviceId String @map("service_id") @db.Uuid
  sortOrder Int    @default(0) @map("sort_order")

  bundle  Bundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@id([bundleId, serviceId])
  @@index([serviceId])
  @@map("bundle_services")
}

model Offer {
  id                    String           @id @default(uuid()) @db.Uuid
  name                  String
  offerCode             String?          @unique @map("offer_code")
  discountType          OfferDiscountType @map("discount_type")
  discountValue         Decimal          @map("discount_value") @db.Decimal(12, 4)
  startDate             DateTime         @map("start_date") @db.Date
  endDate               DateTime         @map("end_date") @db.Date
  usageLimit            Int?             @map("usage_limit")
  perClientUsageLimit   Int?             @map("per_client_usage_limit")
  isActive              Boolean          @default(true) @map("is_active")
  eligibilityRules      Json?            @map("eligibility_rules")
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("offers")
}

enum PriceDisplayType {
  FIXED
  STARTS_FROM
  RANGE
  CONTACT
  HIDDEN
}

enum BundleType {
  FIXED
  FLEXIBLE
  QUANTITY
  MEMBERSHIP_STYLE
}

enum OfferDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  SERVICE
  PACKAGE
  BUNDLE
  FIRST_BOOKING
  SEASONAL
  PROMO_CODE
}

enum BookingSlotStatus {
  AVAILABLE
  PENDING
  FILLED
  BLOCKED
  CLOSED
}

model BookingSlot {
  id               String            @id @default(uuid()) @db.Uuid
  branchId         String            @map("branch_id") @db.Uuid
  date             DateTime          @db.Date
  startTime        DateTime          @map("start_time") @db.Time(0)
  endTime          DateTime          @map("end_time") @db.Time(0)
  capacity         Int
  bookedCount      Int               @default(0) @map("booked_count")
  status           BookingSlotStatus
  isOnlineBookable Boolean           @default(true) @map("is_online_bookable")
  notes            String?
  createdByUserId  String?           @map("created_by_user_id") @db.Uuid
  deletedAt        DateTime?         @map("deleted_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  branch    Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdBy User?  @relation("BookingSlotCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  bookings              Booking[]
  changeRequestTargets  BookingChangeRequest[] @relation("ChangeRequestTargetSlot")

  @@index([branchId, date])
  @@index([branchId, date, startTime])
  @@index([createdByUserId])
  @@index([deletedAt])
  @@map("booking_slots")
}

// --- Sprint 5: Clients + bookings ---

enum ClientIdentityProvider {
  GOOGLE
  FACEBOOK
}

model Client {
  id                  String    @id @default(uuid()) @db.Uuid
  fullName            String    @map("full_name")
  phone               String
  email               String?
  profileImageUrl     String?   @map("profile_image_url")
  gender              String?
  birthDate           DateTime? @map("birth_date") @db.Date
  preferredBranchId   String?   @map("preferred_branch_id") @db.Uuid
  notes               String?
  allergiesOrWarnings String?   @map("allergies_or_warnings")
  tags                String[]  @default([])
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  preferredBranch Branch? @relation("ClientPreferredBranch", fields: [preferredBranchId], references: [id], onDelete: SetNull)
  identities      ClientIdentity[]
  bookings        Booking[]
  changeRequests    BookingChangeRequest[]

  @@index([phone])
  @@map("clients")
}

model ClientIdentity {
  id               String                 @id @default(uuid()) @db.Uuid
  clientId         String                 @map("client_id") @db.Uuid
  provider         ClientIdentityProvider
  providerSubject  String                 @map("provider_subject")
  email            String?
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([clientId])
  @@map("client_identities")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  REQUIRES_FOLLOW_UP
  RESCHEDULED
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REJECTED
  NO_SHOW
}

enum BookingSource {
  WEBSITE
  DASHBOARD
  WALK_IN
  PHONE
  WHATSAPP
  INSTAGRAM
  FACEBOOK
}

enum BookingItemType {
  SERVICE
  SERVICE_VARIANT
  PACKAGE
  BUNDLE
  ADD_ON
}

enum BookingChangeRequestType {
  CANCEL
  RESCHEDULE
}

enum BookingChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model Booking {
  id               String         @id @default(uuid()) @db.Uuid
  clientId         String         @map("client_id") @db.Uuid
  branchId         String         @map("branch_id") @db.Uuid
  slotId           String         @map("slot_id") @db.Uuid
  status           BookingStatus
  source           BookingSource
  subtotal         Decimal        @db.Decimal(12, 2)
  discountAmount   Decimal        @default(0) @map("discount_amount") @db.Decimal(12, 2)
  vatRate          Decimal        @map("vat_rate") @db.Decimal(6, 5)
  vatAmount        Decimal        @map("vat_amount") @db.Decimal(12, 2)
  totalAmount      Decimal        @map("total_amount") @db.Decimal(12, 2)
  clientNotes      String?        @map("client_notes")
  adminNotes       String?        @map("admin_notes")
  createdByUserId  String?        @map("created_by_user_id") @db.Uuid
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  client        Client         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  branch        Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  slot          BookingSlot    @relation(fields: [slotId], references: [id], onDelete: Restrict)
  createdByUser User?          @relation("BookingCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  items         BookingItem[]
  changeRequests BookingChangeRequest[]

  @@index([clientId, createdAt(sort: Desc)])
  @@index([branchId, status, slotId])
  @@index([slotId])
  @@map("bookings")
}

model BookingItem {
  id                        String          @id @default(uuid()) @db.Uuid
  bookingId                 String          @map("booking_id") @db.Uuid
  itemType                  BookingItemType @map("item_type")
  serviceId                 String?         @map("service_id") @db.Uuid
  serviceVariantId          String?         @map("service_variant_id") @db.Uuid
  packageId                 String?         @map("package_id") @db.Uuid
  bundleId                  String?         @map("bundle_id") @db.Uuid
  nameSnapshot              String          @map("name_snapshot")
  priceSnapshot             Decimal         @map("price_snapshot") @db.Decimal(12, 2)
  durationMinutesSnapshot Int             @map("duration_minutes_snapshot")
  quantity                  Int             @default(1)
  /// Optional JSON: e.g. `{ "selectedServiceIds": ["uuid"] }` for flexible bundles (Sprint 5).
  lineMetadata              Json?           @map("line_metadata")
  createdAt                 DateTime        @default(now()) @map("created_at")
  updatedAt                 DateTime        @updatedAt @map("updated_at")

  booking        Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service        Service?        @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  serviceVariant ServiceVariant? @relation(fields: [serviceVariantId], references: [id], onDelete: SetNull)
  package        Package?        @relation(fields: [packageId], references: [id], onDelete: SetNull)
  bundle         Bundle?         @relation(fields: [bundleId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@map("booking_items")
}

model BookingChangeRequest {
  id               String                       @id @default(uuid()) @db.Uuid
  bookingId        String                       @map("booking_id") @db.Uuid
  clientId         String                       @map("client_id") @db.Uuid
  requestType      BookingChangeRequestType     @map("request_type")
  requestedSlotId  String?                      @map("requested_slot_id") @db.Uuid
  reason           String?
  status           BookingChangeRequestStatus
  handledByUserId  String?                      @map("handled_by_user_id") @db.Uuid
  handledAt        DateTime?                    @map("handled_at")
  createdAt        DateTime                     @default(now()) @map("created_at")
  updatedAt        DateTime                     @updatedAt @map("updated_at")

  booking         Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  client          Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  requestedSlot   BookingSlot? @relation("ChangeRequestTargetSlot", fields: [requestedSlotId], references: [id], onDelete: SetNull)
  handledByUser   User?        @relation("BookingChangeRequestHandledBy", fields: [handledByUserId], references: [id], onDelete: SetNull)

  @@index([bookingId, status])
  @@index([clientId, createdAt(sort: Desc)])
  @@map("booking_change_requests")
}

/// Editable WhatsApp message templates for dashboard deep links (SRS §11.4, Sprint 6).
model WhatsAppTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  templateKey String   @unique @map("template_key")
  content     String   @db.Text
  /// JSON array of supported variable names (e.g. clientName, bookingDate) — see API docs.
  variables   Json
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("whatsapp_templates")
}
